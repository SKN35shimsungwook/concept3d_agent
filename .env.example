# 필수: Gemini API 키 (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# 에이전트(컨셉 분석, 도구 호출)에 쓸 모델. 텍스트 모델은 무료 티어가 있음
AGENT_MODEL=gemini-2.5-flash
# 분석 모델에 보낼 썸네일 크기. 384 이하면 이미지 1장이 258토큰
ANALYSIS_IMAGE_SIZE=384

# 정제 방식: rembg(로컬 배경 제거, 무료) | off(안 함) | gemini(이미지 모델로 스타일 변환, 유료)
REFINE_BACKEND=rembg
# rembg 모델 (첫 사용 때 ~/.u2net에 다운로드). u2net 약 170MB, u2netp 약 5MB(가벼움, 품질 낮음)
REMBG_MODEL=u2net
# gemini 정제에 쓸 이미지 모델. 쉼표로 여러 개 적으면 앞 모델이 없을 때 다음 모델을 씀
# (gemini-2.5-flash-image는 2026-10-02 종료 예정이라 제외)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image,gemini-3-pro-image

# 3D 백엔드: trellis(무료 HF Space) | tripo(유료 API)
THREED_BACKEND=trellis
TRELLIS_SPACE=trellis-community/TRELLIS

# 선택: HF 토큰을 넣으면 ZeroGPU 하루 한도가 2분 → 5분 (https://huggingface.co/settings/tokens)
HF_TOKEN=
# 선택: tripo 백엔드를 쓸 때만 (https://platform.tripo3d.ai)
TRIPO_API_KEY=
